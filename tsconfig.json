{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"]
  },
  "include": [
    "js/**/*.js",
    "sw.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".agents",
    ".venv",
    "dl_guu-dl_26",
    "tests"
  ]
}
